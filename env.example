# Companies House MCP server environment

# Required. Your own API key.
# Free registration: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_api_key_here

# Required only when binding Streamable HTTP to a non-loopback address.
# The server refuses to start off-loopback without it. Generate one with:
#   openssl rand -hex 32
# MCP_BEARER_TOKEN=replace_with_a_long_random_token
