# Companies House MCP server environment configuration

# Required: your own Companies House API key
# Get one free at: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=your_api_key_here

# Optional: bearer token for Streamable HTTP
# Required when binding HTTP to a non-loopback address with --host.
# MCP_BEARER_TOKEN=replace_with_a_long_random_token

# Optional: default directory used by download_filing_document in file_path mode
# COMPANIES_HOUSE_DOWNLOAD_DIR=/absolute/path/to/downloads
