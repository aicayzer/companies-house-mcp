{
  "name": "companies-house-cli",
  "version": "2.0.1",
  "description": "CLI for the UK Companies House public register — company search, records, officers, ownership, filings and filed documents. Bring your own free API key.",
  "type": "module",
  "exports": {
    "./mcp": "./dist/server/mcp.js",
    "./server": "./dist/server/index.js",
    "./secret": "./dist/server/secret.js",
    "./tools": "./dist/tools/registry.js"
  },
  "bin": {
    "ch": "dist/cli/index.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:package": "vitest run tests/package-stdio.test.ts",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "clean": "rm -rf dist/ *.tsbuildinfo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "keywords": [
    "companies-house",
    "uk",
    "cli",
    "company-search",
    "api",
    "typescript",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "due-diligence",
    "officers",
    "filings"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aicayzer/companies-house-mcp.git",
    "directory": "packages/cli"
  },
  "homepage": "https://companies-house.uk",
  "bugs": {
    "url": "https://github.com/aicayzer/companies-house-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "files": [
    "dist/",
    ".claude/skills/",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
