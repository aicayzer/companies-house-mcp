{
  "name": "companies-house-mcp",
  "version": "4.0.0",
  "description": "MCP server for the UK Companies House public register — connects Claude, Codex, Cursor, Zed and other MCP clients to live company data. Bring your own free API key.",
  "type": "module",
  "mcpName": "io.github.aicayzer/companies-house",
  "bin": {
    "companies-house-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "rm -rf dist/ *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "companies-house",
    "uk",
    "company-search",
    "claude",
    "api",
    "due-diligence"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aicayzer/companies-house-mcp.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://companies-house.uk",
  "bugs": {
    "url": "https://github.com/aicayzer/companies-house-mcp/issues"
  },
  "dependencies": {
    "companies-house-cli": "workspace:^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "globals": "^14.0.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/",
    ".claude/skills/",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
