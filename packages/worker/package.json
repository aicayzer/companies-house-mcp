{
  "name": "companies-house-mcp-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Optional single-user Cloudflare Worker that serves the Companies House MCP server over Streamable HTTP",
  "type": "module",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "clean": "rm -rf dist/ dist-dryrun/ *.tsbuildinfo",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/ tests/",
    "format:check": "prettier --check src/ tests/",
    "test": "vitest run",
    "test:unit": "vitest run",
    "deploy": "pnpm --filter companies-house-cli build && wrangler deploy",
    "dev": "pnpm --filter companies-house-cli build && wrangler dev",
    "tail": "wrangler tail",
    "secrets": "wrangler secret list"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.2.0",
    "companies-house-cli": "workspace:^2.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.144.0"
  },
  "files": [
    "src/",
    "wrangler.jsonc",
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
